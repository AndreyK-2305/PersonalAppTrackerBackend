# Copia este archivo como .env (no se versiona). Docker Compose lo lee automáticamente.
# Los valores por defecto son SOLO para desarrollo local; en producción usa secretos reales.

# Base de datos (contenedor postgres de docker-compose.yml)
DB_NAME=personal_tracker
DB_USERNAME=personal_tracker
DB_PASSWORD=personal_tracker
# Puerto en el host. 5434 para no chocar con otros PostgreSQL locales en 5432.
DB_PORT=5434

# Puerto del backend en el host: el de ./mvnw spring-boot:run (perfil local) y el publicado
# con el perfil "full" de Docker Compose. Dentro del contenedor siempre es 8080.
BACKEND_PORT=8090

# Puerto del frontend (nginx) publicado con el perfil "full" de Docker Compose.
FRONTEND_PORT=8091

# Registro de cuentas nuevas. Cerrado por defecto; actívalo solo para crear tu primera cuenta
# y vuelve a dejarlo en false (ADR-0012).
REGISTRATION_ENABLED=false

# Cierre de sesión por inactividad (por ejemplo 30m, 60m, 8h).
SESSION_TIMEOUT=60m

# Orígenes permitidos para CORS, separados por comas. Vacío = ninguno
# (el frontend se sirve desde el mismo origen mediante proxy). Con Cloudflare Tunnel, pon aquí el
# dominio público como respaldo, por ejemplo https://cuadre.click.
CORS_ALLOWED_ORIGINS=

# Copias de la base del perfil full: carpeta en este equipo y días que se conservan.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Token del túnel de Cloudflare (perfil tunnel). Se obtiene al crear el túnel en el panel de
# Cloudflare (Zero Trust → Networks → Tunnels). Es un secreto: nunca lo versiones.
TUNNEL_TOKEN=

# Captura automática (ADR-0017). Opcionales: estos son los valores por defecto.
# CAPTURE_JOBS_ENABLED=true            # cola de notificaciones y limpieza del texto a los 45 días
# CAPTURE_WORKER_INTERVAL=PT30S        # cada cuánto revisa la cola
# CAPTURE_EXCHANGE_RATE_URL=https://www.datos.gov.co   # fuente de la TRM
