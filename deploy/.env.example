# Copia este archivo como deploy/.env en el servidor (no se versiona) y completa los valores.

# Dominio de la API. Debe tener un registro DNS A apuntando a la IP pública del servidor antes de
# arrancar, para que Caddy obtenga el certificado HTTPS.
API_DOMAIN=api.cuadre.click

# Origen del frontend (Netlify), para CORS: el proxy de Netlify conserva la cabecera Origin.
CORS_ALLOWED_ORIGINS=https://cuadre.click

# Base de datos. Usa una contraseña larga y aleatoria, por ejemplo: openssl rand -base64 32
DB_NAME=personal_tracker
DB_USERNAME=personal_tracker
DB_PASSWORD=

# Registro de cuentas. Ábrelo (true) solo para crear tu cuenta y vuelve a false (ADR-0012).
REGISTRATION_ENABLED=false

# Cierre de sesión por inactividad.
SESSION_TIMEOUT=60m

# Copias de la base: carpeta en el servidor y días que se conservan.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Puertos del host. En el servidor deben ser 80 y 443 (Let's Encrypt los necesita).
HTTP_PORT=80
HTTPS_PORT=443
