# Proxy inverso con HTTPS automático (Let's Encrypt) para la API.
# API_DOMAIN es, por ejemplo, api.cuadre.click; con "localhost" Caddy usa su propia CA (pruebas).
{$API_DOMAIN} {
	encode zstd gzip

	# Solo se publica la API (incluidos los endpoints de dispositivo) y el health check. Swagger y
	# los demás endpoints de Actuator no salen a internet.
	@app path /api/* /actuator/health /actuator/health/*
	handle @app {
		reverse_proxy backend:8080
	}

	handle {
		respond 404
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
